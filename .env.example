# ------------------------------------------------------------------
# Williams Medical Clinic — environment variables
# Copy this file to `.env.local` and fill in real values.
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string (wired up in the backend phase)
# Example: postgresql://user:password@localhost:5432/williams_clinic
DATABASE_URL=

# Session / auth secrets (used by the authentication phase)
SESSION_SECRET=

# Optional: email provider credentials for appointment / contact notifications
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
