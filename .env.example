# ------------------------------------------------------------------
# Doctor (medical practice) — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real secrets.
#
# Validation: server/config/env.js checks these at startup. With
# NODE_ENV=production the server refuses to start when a required
# variable is missing (it names the variable, never prints values).
# ------------------------------------------------------------------

# ===== Public / browser-safe (inlined into the client bundle) ======
# Canonical site origin (metadata, sitemap, Open Graph, CSRF origin check).
# Production: https://your-domain.example (https required unless localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and PUBLISHABLE key (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ===== Server-only (never NEXT_PUBLIC_, never sent to the browser) ==
# PostgreSQL connection string (Supabase Postgres or your own instance).
# Required in production. Example: postgresql://user:CHANGE_ME@host:5432/doctor_clinic
DATABASE_URL=
# Set to "true" when the database requires TLS (hosted providers).
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10

# Supabase SECRET key: server-only. Needed for `npm run db:seed` (creates the
# staff identities) and any future admin operation. Not read by page code.
SUPABASE_SECRET_KEY=

# Seed accounts (used only by `npm run db:seed`). Passwords live in Supabase
# Auth, never in the app database. Leave a password empty to have the seed
# generate one and print it once. Remove these from production hosts after
# seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# SEED_DOCTOR_EMAIL=
SEED_DOCTOR_PASSWORD=

# ===== Operational (server-only, optional) ==========================
# "json" (default in production) or "text" for structured log lines.
# LOG_FORMAT=json
# Only for a demo deployment WITHOUT a database (public site only, no
# dashboard). Never set this on a real clinic deployment.
# ALLOW_DEMO_MODE=false

# ===== Not implemented ==============================================
# Email/SMS delivery is not configured. Appointment events are queued in the
# `notifications` table for a future provider (see README → Limitations).
