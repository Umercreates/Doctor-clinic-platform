# ------------------------------------------------------------------
# Doctor (medical practice) — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real secrets.
# ------------------------------------------------------------------

# Public site URL (canonical URLs, sitemap, Open Graph). Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Auth ---------------------------------------------------
# Project URL and PUBLISHABLE key are safe for the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET key: server-only (seeding staff accounts / admin operations).
# Never prefix with NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_SECRET_KEY=

# --- Database (server-side only) -----------------------------------
# PostgreSQL connection string for the application data (doctors, patients,
# appointments, availability, roles). Required for the dashboard and persisted bookings.
# Example: postgresql://doctor_clinic:CHANGE_ME@localhost:5432/doctor_clinic
DATABASE_URL=
# Set to "true" when the database requires TLS (most hosted providers).
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# --- Seed accounts (used only by `npm run db:seed`) -----------------
# The seed creates these identities in Supabase Auth (server-side) and links
# them to application roles. Passwords are never stored in the app database.
# If a password is left empty the seed generates a random one and prints it once.
SEED_ADMIN_EMAIL=easylifeumer@gmail.com
SEED_ADMIN_PASSWORD=
# Login for Dr. Williams (role: doctor). Email defaults to dr.williams@doctor-clinic-demo.com
# SEED_DOCTOR_EMAIL=
SEED_DOCTOR_PASSWORD=

# --- Optional: email provider for notifications (later phase) --------
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
